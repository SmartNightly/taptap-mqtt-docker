          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"strings\"\nfrom(bucket: \"ioBroker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] =~ /^javascript\\.0\\.Tigo\\.A[0-9][0-9]\\.power$/ and r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({ r with _measurement: strings.trimSuffix(v: strings.trimPrefix(v: r._measurement, prefix: \"javascript.0.Tigo.\"), suffix: \".power\") }))",
          "refId": "A"
        }
